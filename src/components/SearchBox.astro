---
interface Props { big?: boolean; value?: string; id?: string }
const { big = false, value = '', id = 'q' } = Astro.props;
---
<form class:list={['searchbox', { big }]} action="/search/" method="get" role="search">
  <label class="sr" for={id}>Search perfumes, houses, notes or inspirations</label>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  <input id={id} name="q" type="search" value={value} autocomplete="off" placeholder="Creed Aventus, oud…" />
  <button type="submit">Search</button>
</form>
