---
// Brand-hosted product photo. If the brand's server refuses the image, show the first letter instead.
import { imgUrl } from '../lib/data';
interface Props { src?: string | null; name: string; eager?: boolean; size?: number }
const { src, name, eager = false, size = 400 } = Astro.props;
---
<div class:list={['thumb', { noimg: !src }]} data-initial={name.trim()[0]}>
  {src && (
    <img src={imgUrl(src, size * 2 > 1200 ? 1200 : size * 2)!} alt="" width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async"
      referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('noimg');this.remove()" />
  )}
</div>
