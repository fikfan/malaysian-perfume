---
import Thumb from './Thumb.astro';
import { pyramid, perfumeUrl, searchFamilies, ROW_IMG, GENDER_LABEL, type Perfume } from '../lib/data';

interface Props { p: Perfume; houseName?: string; shared?: string[] }
const { p, houseName, shared = [] } = Astro.props;
const on = new Set(shared);
const layers = pyramid(p);
const d = p.data;
// what the house-page filter box matches against (same words, oud names included, as the main search)
const notes = layers.flatMap((l) => l.notes);
const k = [d.name, d.inspiredBy, ...notes].filter(Boolean).join(' ') + searchFamilies([d.name, d.inspiredBy, ...notes]);
---
<li class="prow" data-k={k} data-gender={d.gender ?? ''} data-discontinued={d.discontinued ? '1' : ''}>
  <div class="thumb-wrap"><Thumb src={d.image} name={d.name} size={ROW_IMG} /></div>
  <div>
    <h3><a href={perfumeUrl(p)}>{d.name}</a></h3>
    {houseName && <p class="meta">by <b>{houseName}</b></p>}
    {d.inspiredBy && <p class="meta">Inspired by <b>{d.inspiredBy}</b></p>}
    <div class="tags">
      {d.gender && <span class="tag">{GENDER_LABEL[d.gender]}</span>}
      {d.discontinued && <span class="tag warn">Discontinued</span>}
    </div>
  </div>
  {layers.length ? (
    <p class="notes-line">{layers.map((l, i) => <>{i > 0 && ' '}<span class="layer" data-l={l.label}>{l.label}</span> {l.notes.map((n, j) => <>{j > 0 && ', '}{on.has(n) ? <strong>{n}</strong> : n}</>)}.</>)}</p>
  ) : (
    <p class="notes-line"><span>The brand does not list notes for this one.</span></p>
  )}
</li>
