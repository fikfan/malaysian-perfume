---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';

interface Props { title: string; description?: string; showSearch?: boolean }
const { title, description = 'A free library of perfumes made by Malaysian houses: notes, inspirations and links, taken from each brand.', showSearch = true } = Astro.props;
const path = Astro.url.pathname;
const full = title === 'Malaysian Perfumes' ? title : `${title} | Malaysian Perfumes`;
const nav = [
  { href: '/houses/', label: 'Houses' },
  { href: '/inspired/', label: 'Inspired by' },
  { href: '/search/', label: 'Search' },
];
---
<!doctype html>
<html lang="en-MY">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    // hold the page behind a brief loader until the font is in, so text does not jump; never longer than 1.2 s
    (() => {
      const r = document.documentElement; r.classList.add('js', 'loading');
      const done = () => r.classList.remove('loading');
      setTimeout(done, 1200);
      addEventListener('DOMContentLoaded', () => document.fonts.ready.then(done));
    })();
  </script>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="loader" aria-hidden="true"><img src="/logo.svg" alt="" width="40" height="40" /></div>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a class="logo" href="/"><img src="/logo.svg" alt="" width="28" height="28" />Malaysian Perfumes</a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Night mode" aria-pressed="false">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </header>
  {showSearch && <div class="head-search-band"><div class="wrap head-search"><SearchBox /></div></div>}
  <main id="main"><slot /></main>
  <footer class="site-foot">
    <div class="wrap">
      <div>
        <p><strong>Malaysian Perfumes</strong> is a free library of perfumes made by Malaysian houses.</p>
        <p>It is not linked to any brand. Notes, sizes and inspirations come from each brand's own website or online store, and every perfume page links to its source. Prices are not shown.</p>
        <p>Made by <a href="https://github.com/fikfan">fikfan</a>, a Malaysian web designer.</p>
      </div>
      <div>
        <p><strong>Is your house missing, or is something wrong?</strong></p>
        <p><a href="https://github.com/fikfan/malaysianperfumes/issues">Send a correction on GitHub</a>. Brands can ask to be added or removed.</p>
      </div>
    </div>
  </footer>
  <script is:inline>
    (() => {
      const b = document.getElementById('theme-toggle'), root = document.documentElement;
      const dark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const sync = () => b.setAttribute('aria-pressed', String(dark()));
      sync();
      const flip = () => {
        root.dataset.theme = dark() ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        sync();
      };
      // cross-fade the whole page between themes where supported
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      b.addEventListener('click', () => (document.startViewTransition && !still ? document.startViewTransition(flip) : flip()));
    })();
  </script>
</body>
</html>

<style>
  .head-search-band { border-bottom: 1px solid var(--rule); }
  .head-search { padding-block: 14px; }
  .head-search :global(.searchbox) { max-width: 640px; }
</style>
