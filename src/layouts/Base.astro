---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';
import ExtLink from '../components/ExtLink.astro';
import { iconSvg } from '../lib/icons';
import profileJson from '../data/profile.json';
import { z } from 'astro/zod';
import { REPO_URL } from '../lib/site';
import { clip } from '../lib/seo';
// validated like the content collections: links go into hrefs on every page
const profile = z.object({
  name: z.string(),
  about: z.string(),
  links: z.array(z.object({ label: z.string(), href: z.url({ protocol: /^https$/ }), icon: z.string() })),
}).parse(profileJson);
const linkedin = profile.links.find((l) => l.icon === 'linkedin');
if (!linkedin) throw new Error('profile.json: a link with icon "linkedin" is required');

interface Props {
  title: string;
  description?: string;
  showSearch?: boolean;
  image?: string | null;            // share image; defaults to the site card
  jsonLd?: object | object[];       // structured data for this page
  noindex?: boolean;
}
const { title, description: rawDescription = 'A free library of perfumes made by Malaysian houses: notes, inspirations and links, taken from each brand.', showSearch = true, image, jsonLd, noindex = false } = Astro.props;
const description = clip(rawDescription);
const path = Astro.url.pathname;
const full = title.includes('Malaysian Perfumes') ? title : `${title} | Malaysian Perfumes`;
const canonical = new URL(path, Astro.site).href;
const shareImage = image ?? new URL('/og.png', Astro.site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const nav = [
  { href: '/houses/', label: 'Houses' },
  { href: '/inspired/', label: 'Inspired by' },
  { href: '/search/', label: 'Search' },
];
---
<!doctype html>
<html lang="en-MY">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:site_name" content="Malaysian Perfumes" />
  <meta property="og:locale" content="en_MY" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImage} />
  <meta name="twitter:card" content={image ? 'summary' : 'summary_large_image'} />
  {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x).replace(/</g, '\\u003c')} />)}
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
  <script is:inline src="/head.js"></script>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="loader" aria-hidden="true"><img src="/logo.svg" alt="" width="40" height="40" /></div>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a class="logo" href="/"><img src="/logo.svg" alt="" width="28" height="28" />Malaysian Perfumes</a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Night mode" aria-pressed="false">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </header>
  {showSearch && <div class="head-search-band"><div class="wrap head-search"><SearchBox /></div></div>}
  <main id="main"><slot /></main>
  <footer class="site-foot">
    <div class="wrap">
      <div>
        <p><strong>Malaysian Perfumes</strong> is a free library of perfumes made by Malaysian houses.</p>
        <p>It is not linked to any brand. Notes, sizes and inspirations come from each brand's own website or online store, and every perfume page links to its source. Prices are not shown.</p>
        <!-- without JS the name is a plain link to the first profile link -->
        <p>Made with love by <a href={profile.links[0].href} id="profile-open" aria-haspopup="dialog">{profile.name}</a></p>
      </div>
      <div>
        <p><strong>Is your brand not featured, or is something wrong?</strong></p>
        <p>Message me on <ExtLink href={linkedin.href}>LinkedIn</ExtLink>. Brands can ask to be added, corrected or removed.</p>
        <p><strong>Want to contribute?</strong> The site is open source. <ExtLink href={REPO_URL}>Contribute here</ExtLink>.</p>
      </div>
    </div>
  </footer>
  <dialog class="profile" id="profile" aria-labelledby="profile-name">
    <form method="dialog"><button class="profile-close" aria-label="Close">×</button></form>
    <img src="/logo.svg" alt="" width="40" height="40" />
    <h2 id="profile-name">{profile.name}</h2>
    <p class="muted">{profile.about}</p>
    <ul>
      {profile.links.map((l) => <li><ExtLink class="btn" href={l.href}><Fragment set:html={iconSvg(l.icon)} />{l.label}</ExtLink></li>)}
    </ul>
  </dialog>
  <script>
    // footer name opens the profile card; clicking outside the card closes it
    (() => {
      const d = document.getElementById('profile') as HTMLDialogElement;
      document.getElementById('profile-open')!.addEventListener('click', (e) => { e.preventDefault(); d.showModal(); });
      d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    })();
  </script>
  <script>
    (() => {
      const b = document.getElementById('theme-toggle')!, root = document.documentElement;
      const dark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const sync = () => {
        b.setAttribute('aria-pressed', String(dark()));
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', dark() ? '#141414' : '#ffffff'));
      };
      sync();
      const flip = () => {
        root.dataset.theme = dark() ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        sync();
      };
      // cross-fade the whole page between themes where supported
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      b.addEventListener('click', () => ('startViewTransition' in document && !still ? document.startViewTransition(flip) : flip()));
    })();
  </script>
</body>
</html>

<style>
  .head-search-band { border-bottom: 1px solid var(--rule); }
  .head-search { padding-block: 14px; }
  .head-search :global(.searchbox) { max-width: 640px; }
</style>
