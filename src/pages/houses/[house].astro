---
import Base from '../../layouts/Base.astro';
import PerfumeRow from '../../components/PerfumeRow.astro';
import ExtLink from '../../components/ExtLink.astro';
import { load, host, perfumeUrl, houseUrl, TYPE_LABEL, GENDER_LABEL, type House } from '../../lib/data';
import { breadcrumbLd, itemListLd } from '../../lib/seo';
import { iconSvg } from '../../lib/icons';

export async function getStaticPaths() {
  const { houses } = await load();
  return houses.map((h) => ({ params: { house: h.id }, props: { h } }));
}
const { h } = Astro.props as { h: House };
const { byHouse } = await load();
const list = byHouse.get(h.id) ?? [];
const d = h.data;
const genders = (['masculine', 'feminine', 'unisex'] as const).filter((g) => list.some((p) => p.data.gender === g));
const discontinued = list.filter((p) => p.data.discontinued).length;
const named = list.filter((p) => p.data.inspiredBy).length;
const link = (href: string | null | undefined, label: string, key: string) => (href ? [{ href, label, key }] : []);
const links = [
  ...link(d.website, 'Website', 'web'),
  ...link(d.shopee, 'Shopee', 'shopee'),
  ...link(d.lazada, 'Lazada', 'lazada'),
  ...link(d.tiktok && `https://www.tiktok.com/@${d.tiktok}`, 'TikTok', 'tiktok'),
  ...link(d.instagram && `https://www.instagram.com/${d.instagram}/`, 'Instagram', 'instagram'),
];
---
<Base
  title={`${d.name} perfumes: notes and full list`}
  description={`All ${list.length} ${d.name} perfumes${d.location ? ` (${d.location})` : ''} with their notes${named ? ', what each one is inspired by,' : ''} and where the brand sells them. ${d.about}`}
  jsonLd={[breadcrumbLd([['Houses', '/houses/'], [d.name, houseUrl(h.id)]]), itemListLd(`${d.name} perfumes`, list.map((p) => [p.data.name, perfumeUrl(p)]))]}
>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/houses/">Houses</a><span aria-hidden="true">/</span>{d.name}</nav>
      <h1 class="x">{d.name}</h1>
      <p>{d.about}</p>
    </header>

    <div class="top">
      <dl class="facts">
        <dt>Makes</dt><dd>{TYPE_LABEL[d.type]}{d.type !== 'original' && named === 0 && <span class="muted">. The brand does not name which scent each perfume is inspired by.</span>}</dd>
        <dt>Founded</dt><dd>{d.founded ?? <span class="muted">Not stated</span>}</dd>
        <dt>Based in</dt><dd>{d.location ?? <span class="muted">Not stated</span>}</dd>
        <dt>Listed here</dt><dd>{list.length} perfumes{discontinued > 0 && <span class="muted"> ({discontinued} discontinued)</span>}{d.partial && <span class="muted">. The brand sells more; they are being added.</span>}</dd>
      </dl>
      {links.length > 0 && (
        <div>
          <h2 class="sr">Where to find {d.name}</h2>
          <div class="btn-row">{links.map((l) => <ExtLink class={`btn brand-${l.key}`} href={l.href}><Fragment set:html={iconSvg(l.key)} />{l.label}</ExtLink>)}</div>
        </div>
      )}
    </div>

    <section class="section" aria-labelledby="h-perfumes">
      <div class="section-head"><h2 id="h-perfumes">Perfumes</h2></div>
      <div class="filters" id="filters">
          <label class="sr" for="house-q">Search {d.name} perfumes</label>
          <input class="filter" id="house-q" type="search" placeholder={`Search ${list.length} perfumes or notes`} autocomplete="off" />
          {genders.length > 1 && (
            <div class="seg" role="group" aria-label="Filter by who it is for">
              <button type="button" aria-pressed="true" data-g="">All</button>
              {genders.map((g) => <button type="button" aria-pressed="false" data-g={g}>{GENDER_LABEL[g]}</button>)}
            </div>
          )}
          {discontinued > 0 && <label class="check"><input type="checkbox" id="show-disc" checked /> Show discontinued</label>}
          <span class="count" id="count" aria-live="polite">{list.length} perfumes</span>
      </div>
      <ul class="plist" id="plist">{list.map((p) => <PerfumeRow p={p} />)}</ul>
      <p class="empty muted" id="no-match" hidden>No {d.name} perfume matches. Try another word, or clear the filters.</p>
      <div id="more" aria-hidden="true"></div>
    </section>

    {d.sources.length > 0 && (
      <p class="sources muted">Facts on this page come from: {d.sources.map((s, i) => <>{i > 0 && ', '}<ExtLink href={s}>{host(s) + new URL(s).pathname.replace(/\/$/, '')}</ExtLink></>)}</p>
    )}
  </div>
</Base>

<script>
  import { haystack, terms, matches } from '../../lib/match';
  const f = document.getElementById('filters');
  if (f) {
    let g = '';
    const PAGE = 20; // rows shown at a time; more load as the visitor scrolls
    let limit = PAGE;
    const disc = document.getElementById('show-disc') as HTMLInputElement | null;
    const q = document.getElementById('house-q') as HTMLInputElement;
    const rows = [...document.querySelectorAll<HTMLElement>('#plist .prow')];
    const keys = rows.map((r) => haystack(r.dataset.k ?? ''));
    const more = document.getElementById('more')!;
    const apply = () => {
      const ts = terms(q.value);
      let n = 0;
      rows.forEach((r, i) => {
        const match = (!g || r.dataset.gender === g) && (!disc || disc.checked || !r.dataset.discontinued)
          && matches(keys[i], ts);
        if (match) n++;
        r.hidden = !match || n > limit;
      });
      document.getElementById('count')!.textContent = `${n} perfume${n === 1 ? '' : 's'}`;
      document.getElementById('no-match')!.hidden = n > 0;
      more.dataset.left = String(Math.max(0, n - limit));
    };
    // Re-observe after every change: a sentinel that never left the screen gives no new event otherwise
    const io = new IntersectionObserver((e) => {
      if (e[0].isIntersecting && Number(more.dataset.left) > 0) { limit += PAGE; apply(); recheck(); }
    }, { rootMargin: '600px' });
    const recheck = () => { io.unobserve(more); io.observe(more); };
    io.observe(more);
    const reset = () => { limit = PAGE; apply(); recheck(); };
    q.addEventListener('input', reset);
    f.querySelectorAll<HTMLButtonElement>('[data-g]').forEach((b) => b.addEventListener('click', () => {
      g = b.dataset.g ?? '';
      f.querySelectorAll('[data-g]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      reset();
    }));
    disc?.addEventListener('change', reset);
    apply();
  }
</script>

<style>
  .top { display: grid; gap: 16px; margin-bottom: 40px; max-width: 640px; }
  .sources { font-size: 14px; margin-top: 24px; overflow-wrap: anywhere; }
  .sources a { color: var(--muted); }
</style>
