---
import Base from '../../layouts/Base.astro';
import ExtLink from '../../components/ExtLink.astro';
import { load, houseUrl, host, countLabel, TYPE_LABEL } from '../../lib/data';
import upcoming from '../../data/upcoming.json';
import profile from '../../data/profile.json';
import { itemListLd } from '../../lib/seo';

const { houses, perfumes, byHouse } = await load();
const stats = [
  [houses.length, 'houses'],
  [perfumes.length, 'perfumes'],
  [perfumes.filter((p) => p.data.inspiredBy).length, 'name an inspiration'],
] as const;
---
<Base title="Malaysian perfume houses" description={`All ${houses.length} Malaysian perfume houses in the library, from niche originals to local takes on designer scents, with how many perfumes each one has.`} jsonLd={itemListLd('Malaysian perfume houses', houses.map((h) => [h.data.name, houseUrl(h.id)]))}>
  <div class="wrap">
    <header class="page-head head-stats">
      <div>
        <h1 class="x">Houses</h1>
        <p>Every Malaysian perfume house in the library so far. More are being added.</p>
      </div>
      <dl class="stats">{stats.map(([n, label]) => <div><dt>{label}</dt><dd>{n}</dd></div>)}</dl>
    </header>

    <div class="table-wrap">
      <table>
        <caption class="sr">Perfume houses in the library</caption>
        <thead><tr><th scope="col">House</th><th scope="col">Makes</th><th scope="col">Based in</th><th scope="col" class="num">Perfumes</th><th scope="col">Website</th></tr></thead>
        <tbody>
          {houses.map((h) => (
            <tr>
              <th scope="row"><a href={houseUrl(h.id)}>{h.data.name}</a></th>
              <td>{TYPE_LABEL[h.data.type]}</td>
              <td>{h.data.location ?? <span class="muted">Not stated</span>}</td>
              <td class="num">{countLabel(h, byHouse.get(h.id)?.length ?? 0)}</td>
              <td>{h.data.website ? <ExtLink href={h.data.website}>{host(h.data.website)}</ExtLink> : <span class="muted">None</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="section" aria-labelledby="h-next">
      <div class="section-head"><h2 id="h-next">Not listed yet</h2><span class="muted">These houses are next. Brands can ask to be added sooner.</span></div>
      <ul class="next">{upcoming.toSorted().map((n) => <li>{n}</li>)}</ul>
      <p class="muted feature-note">Want to be featured? It's free, just let me know on <ExtLink href={profile.links.find((l) => l.icon === 'linkedin')!.href}>LinkedIn</ExtLink>.</p>
    </section>
  </div>
</Base>

<style>
  .head-stats { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 40px; flex-wrap: wrap; }
  .stats { display: flex; gap: 36px; margin: 0; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-size: clamp(30px, 3.6vw, 46px); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .stats dt { margin-top: 6px; font-size: 13.5px; color: var(--muted); }
  @media (max-width: 560px) { .stats { gap: 24px; } }
  .feature-note { margin-top: 16px; font-size: 14.5px; }
  .table-wrap { overflow-x: auto; border-top: var(--line); }
  table { width: 100%; border-collapse: collapse; font-size: 16px; }
  th, td { text-align: left; padding: 14px 16px 14px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  thead th { font-size: 13.5px; color: var(--muted); font-weight: 600; padding-block: 10px; }
  tbody th { font-weight: 750; font-size: 18px; }
  tbody th a { text-decoration: none; }
  tbody tr:hover th a { text-decoration: underline; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .next { list-style: none; margin: 0; padding: 0; columns: 3 220px; column-gap: 24px; }
  .next li { padding: 8px 0; border-bottom: 1px solid var(--rule); break-inside: avoid; }
  @media (max-width: 640px) {
    thead { display: none; }
    tr { display: grid; grid-template-columns: 1fr auto; padding: 12px 0; border-bottom: 1px solid var(--rule); }
    th, td { border: 0; padding: 2px 0; }
    tbody th { grid-column: 1; }
    td.num { grid-column: 2; grid-row: 1; align-self: center; font-weight: 700; }
    td.num::after { content: " perfumes"; font-weight: 400; color: var(--muted); }
    td { grid-column: 1 / -1; font-size: 14.5px; color: var(--muted); }
  }
</style>
