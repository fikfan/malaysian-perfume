---
import Base from '../../../layouts/Base.astro';
import Thumb from '../../../components/Thumb.astro';
import PerfumeRow from '../../../components/PerfumeRow.astro';
import ExtLink from '../../../components/ExtLink.astro';
import { load, pyramid, allNotes, perfumeSlug, perfumeUrl, houseUrl, searchUrl, inspiredUrl, fmtSizes, noteCounts, host, imgUrl, GENDER_LABEL, DATA_CHECKED, type House, type Perfume } from '../../../lib/data';
import { breadcrumbLd, perfumeLd } from '../../../lib/seo';

export async function getStaticPaths() {
  const { perfumes, houses } = await load();
  const byId = new Map(houses.map((h) => [h.id, h]));
  return perfumes.map((p) => ({ params: { house: p.data.house, perfume: perfumeSlug(p) }, props: { p, house: byId.get(p.data.house)! } }));
}
const { p, house } = Astro.props as { p: Perfume; house: House };
const { houses, perfumes, byHouse } = await load();
const d = p.data;
const layers = pyramid(p);
const mine = new Set(allNotes(p));
const houseName = (id: string) => houses.find((h) => h.id === id)?.data.name ?? id;

// Other local perfumes the brands say are inspired by the same scent
const sameInspo = d.inspiredBy ? perfumes.filter((x) => x !== p && x.data.inspiredBy === d.inspiredBy) : [];
// Most shared notes, from any house, excluding the ones already shown above
const shown = new Set([p, ...sameInspo]);
const freq = new Map(await noteCounts());
// Tuning for "Similar notes"
const COMMON = 0.15;     // a note in more than 15% of the library says little about a scent
const LONG_LIST = 20;    // perfumes listing more notes than this must share 3, not 2
const SIMILAR_MAX = 5;
const MORE_MAX = 4;
// Compare what a scent dries down to: heart and base notes when the brand gives a pyramid
const body = (x: Perfume) => {
  const ls = pyramid(x).filter((l) => l.label !== 'Top');
  return ls.length && ls.length < pyramid(x).length ? [...new Set(ls.flatMap((l) => l.notes))] : allNotes(x);
};
const telling = new Set(body(p).filter((n) => (freq.get(n) ?? 0) <= perfumes.length * COMMON));
const similar = telling.size >= 2
  ? perfumes.filter((x) => !shown.has(x))
      .map((x) => {
        const notesX = body(x);
        const shared = notesX.filter((n) => telling.has(n));
        // rarity-weighted overlap, divided by list length so 60-note perfumes do not match everything
        const size = notesX.length;
        return { x, shared, size, s: shared.reduce((t, n) => t + 1 / Math.log(1 + (freq.get(n) ?? 1)), 0) / Math.sqrt(size) };
      })
      .filter((r) => r.shared.length >= (r.size > LONG_LIST ? 3 : 2)).sort((a, b) => b.s - a.s || a.x.data.name.localeCompare(b.x.data.name)).slice(0, SIMILAR_MAX)
  : [];
// Perfumes from the same house: current ones first, then the names next to this one
const sib = byHouse.get(d.house) ?? [];
const at = sib.indexOf(p);
const more = sib.filter((x) => !shown.has(x) && !similar.some((s) => s.x === x))
  .sort((a, b) => Number(!!a.data.discontinued) - Number(!!b.data.discontinued) || Math.abs(sib.indexOf(a) - at) - Math.abs(sib.indexOf(b) - at))
  .slice(0, MORE_MAX);
// Lead line: only the brand's own words, so it shows only when one of those fields is set
const hn = house.data.name;
const described = d.describedAs?.length ? `${hn} describes it as ${new Intl.ListFormat('en').format(d.describedAs)}.` : '';
const desc = `${d.name} by ${house.data.name}, a Malaysian perfume${d.inspiredBy ? `. ${house.data.name} names ${d.inspiredBy} as its inspiration` : ''}. Notes: ${[...mine].slice(0, 8).join(', ') || 'not listed'}.`;
---
<Base
  searchBand
  title={`${d.name} by ${house.data.name}: notes${d.inspiredBy ? ' and inspiration' : ''}`}
  description={desc}
  image={imgUrl(d.image, 1200)}
  jsonLd={[
    breadcrumbLd([['Houses', '/houses/'], [house.data.name, houseUrl(d.house)], [d.name, perfumeUrl(p)]]),
    perfumeLd({ name: d.name, brand: house.data.name, brandPath: houseUrl(d.house), path: perfumeUrl(p), description: desc, image: imgUrl(d.image, 1200), inspiredBy: d.inspiredBy, sameAs: d.source }),
  ]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/houses/">Houses</a><span aria-hidden="true">/</span><a href={houseUrl(d.house)}>{house.data.name}</a><span aria-hidden="true">/</span>{d.name}</nav>

    <article class="perfume">
      <div class="photo"><Thumb src={d.image} name={d.name} eager size={720} alt={`${d.name} by ${house.data.name}, bottle`} /></div>
      <div class="info">
        <h1><span class="x">{d.name}</span> <span class="by">by <a href={houseUrl(d.house)}>{house.data.name}</a></span></h1>
        {(d.inspiredBy || described) && <p class="lead">{d.inspiredBy && <>{hn} says it is inspired by <a href={inspiredUrl(d.inspiredBy, sameInspo.length + 1)}>{d.inspiredBy}</a>. </>}{described}</p>}
        <p class="src muted">{d.source ? <>Notes and details from <ExtLink href={d.source}>{host(d.source)} (product page)</ExtLink></> : 'Notes and details sent by the brand'}, checked {DATA_CHECKED}.</p>
        {d.discontinued && <p><span class="tag warn">Discontinued by the brand</span></p>}

        <h2 class="label">Notes</h2>
        {layers.length ? (
          <dl class="pyramid">
            {layers.map((l) => (
              <div>
                <dt><span class="layer big" data-l={l.label}>{l.label === 'Notes' ? 'All notes' : l.label}</span></dt>
                <dd><ul class="chips">{l.notes.map((n) => <li><a class="chip" href={searchUrl(n)}>{n}</a></li>)}</ul></dd>
              </div>
            ))}
          </dl>
        ) : <p class="muted">{house.data.name} does not list notes for this perfume.</p>}
        {layers.length === 1 && layers[0].label === 'Notes' && <p class="hint muted">The brand lists the notes without splitting them into top, heart and base.</p>}

        <div class="label-row">
          <h2 class="label">Details</h2>
          <details class="about-data">
            <summary aria-label="About these details">i</summary>
            <p>We list only what is confirmed and available on the brand's website or in its marketing.</p>
          </details>
        </div>
        <dl class="facts">
          <dt>For</dt><dd>{d.gender ? GENDER_LABEL[d.gender] : <span class="muted">Not stated</span>}</dd>
          <dt>Type</dt><dd>{d.concentration ?? <span class="muted">Not stated</span>}</dd>
          <dt>Sizes</dt><dd>{fmtSizes(d.sizesMl) ?? <span class="muted">Not stated</span>}</dd>
        </dl>

      </div>
    </article>

    {sameInspo.length > 0 && (
      <section class="section" aria-labelledby="h-same">
        <div class="section-head"><h2 id="h-same">Other local takes on {d.inspiredBy}</h2></div>
        <ul class="plist">{sameInspo.map((x) => <PerfumeRow p={x} houseName={houseName(x.data.house)} />)}</ul>
      </section>
    )}
    {similar.length > 0 && (
      <section class="section" aria-labelledby="h-sim">
        <div class="section-head"><h2 id="h-sim">Similar notes</h2><span class="muted">Local perfumes that share the less common heart and base notes of {d.name}. Very common notes such as musk are ignored.</span></div>
        <ul class="plist">{similar.map(({ x, shared }) => <PerfumeRow p={x} houseName={houseName(x.data.house)} shared={shared} />)}</ul>
      </section>
    )}
    {more.length > 0 && (
      <section class="section" aria-labelledby="h-more">
        <div class="section-head"><h2 id="h-more">More from {house.data.name}</h2><a href={houseUrl(d.house)}>See all {byHouse.get(d.house)?.length}</a></div>
        <ul class="plist">{more.map((x) => <PerfumeRow p={x} />)}</ul>
      </section>
    )}
  </div>
</Base>

<style>
  .crumbs { padding-top: 24px; }
  .perfume { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 48px; padding: 8px 0 40px; align-items: start; }
  .photo { position: sticky; top: 16px; }
  h1 { font-weight: 800; font-size: clamp(34px, 4.6vw, 60px); }
  h1 .by { display: block; margin-top: 8px; font-size: 18px; font-weight: 600; letter-spacing: 0; line-height: 1.3; }
  h1 .by a { text-decoration: none; }
  h1 .by a:hover { text-decoration: underline; }
  .lead { font-size: 18px; margin: 14px 0 0; }
  .lead a { font-weight: 600; }
  .label { font-size: 16px; font-weight: 750; margin: 28px 0 10px; letter-spacing: 0; }
  .label-row { display: flex; align-items: center; gap: 8px; position: relative; }
  .about-data summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 20px; height: 20px; margin-top: 18px; border: 1px solid var(--rule); border-radius: 50%; font: italic 700 12px/1 Georgia, serif; color: var(--muted); }
  .about-data summary::-webkit-details-marker { display: none; }
  .about-data summary:hover, .about-data[open] summary { color: var(--ink); border-color: var(--ink); }
  .about-data p { position: absolute; z-index: 2; left: 0; top: calc(100% - 4px); max-width: min(320px, 100%); margin: 0; padding: 10px 12px; font-size: 14px; background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); box-shadow: 0 4px 16px rgb(0 0 0 / .08); }
  .pyramid { margin: 0; border-top: var(--line); }
  .pyramid > div { display: grid; grid-template-columns: 84px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .pyramid dt { padding-top: 4px; }
  .layer.big { font-size: 13.5px; padding: 2px 8px; }
  .pyramid dd { margin: 0; }
  .hint { font-size: 14px; margin: 8px 0 0; }
  .src { margin: 10px 0 0; font-size: 14.5px; }
  .src a { color: inherit; }
  @media (max-width: 860px) {
    .perfume { grid-template-columns: 1fr; gap: 0; }
    .photo { position: static; max-width: 420px; }
    /* phones: name, house and lead line above the photo, so the H1 is on the first screen */
    .info { display: contents; }
    .photo { order: 1; margin-top: 20px; }
    .info > :not(h1, .lead, .src) { order: 2; }
    /* inline links: vertical padding on an inline box grows the tap area to ~44px without moving the text */
    .crumbs a, .info :is(h1, .lead) a, .src :global(a) { padding-block: 15px; }
  }
</style>
