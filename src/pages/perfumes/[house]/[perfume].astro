---
import Base from '../../../layouts/Base.astro';
import Thumb from '../../../components/Thumb.astro';
import PerfumeRow from '../../../components/PerfumeRow.astro';
import { load, pyramid, allNotes, perfumeSlug, houseUrl, searchUrl, fmtSizes, noteCounts, GENDER_LABEL, DATA_CHECKED } from '../../../lib/data';

export async function getStaticPaths() {
  const { perfumes } = await load();
  return perfumes.map((p) => ({ params: { house: p.data.house, perfume: perfumeSlug(p) } }));
}
const { houses, perfumes, byHouse } = await load();
const p = perfumes.find((x) => x.data.house === Astro.params.house && perfumeSlug(x) === Astro.params.perfume)!;
const d = p.data;
const house = houses.find((h) => h.id === d.house)!;
const layers = pyramid(p);
const mine = new Set(allNotes(p));
const houseName = (id: string) => houses.find((h) => h.id === id)?.data.name ?? id;

// Other local perfumes the brands say are inspired by the same scent
const sameInspo = d.inspiredBy ? perfumes.filter((x) => x !== p && x.data.inspiredBy === d.inspiredBy) : [];
// Most shared notes, from any house, excluding the ones already shown above
const shown = new Set([p, ...sameInspo]);
const freq = new Map(await noteCounts());
// Compare what a scent dries down to: heart and base notes when the brand gives a pyramid
const body = (x: typeof p) => { const ls = pyramid(x); return ls.length === 3 ? [...new Set([...ls[1].notes, ...ls[2].notes])] : allNotes(x); };
const telling = new Set(body(p).filter((n) => (freq.get(n) ?? 0) <= perfumes.length * 0.15));
const similar = telling.size >= 2
  ? perfumes.filter((x) => !shown.has(x))
      .map((x) => {
        const notesX = body(x);
        const shared = notesX.filter((n) => telling.has(n));
        // rarity-weighted overlap, divided by list length so 60-note perfumes do not match everything
        const size = notesX.length;
        return { x, shared, size, s: shared.reduce((t, n) => t + 1 / Math.log(1 + (freq.get(n) ?? 1)), 0) / Math.sqrt(size) };
      })
      .filter((r) => r.shared.length >= (r.size > 20 ? 3 : 2)).sort((a, b) => b.s - a.s || a.x.data.name.localeCompare(b.x.data.name)).slice(0, 5)
  : [];
// Perfumes from the same house: current ones first, then the names next to this one
const sib = byHouse.get(d.house) ?? [];
const at = sib.indexOf(p);
const more = sib.filter((x) => x !== p && !shown.has(x) && !similar.some((s) => s.x === x))
  .sort((a, b) => Number(!!a.data.discontinued) - Number(!!b.data.discontinued) || Math.abs(sib.indexOf(a) - at) - Math.abs(sib.indexOf(b) - at))
  .slice(0, 4);
const host = new URL(d.source).hostname.replace(/^www\./, '');
const desc = `${d.name} by ${house.data.name}${d.inspiredBy ? `, inspired by ${d.inspiredBy}` : ''}. Notes: ${[...mine].slice(0, 8).join(', ') || 'not listed'}.`;
---
<Base title={`${d.name} by ${house.data.name}`} description={desc}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/houses/">Houses</a><span aria-hidden="true">/</span><a href={houseUrl(d.house)}>{house.data.name}</a><span aria-hidden="true">/</span>{d.name}</nav>

    <article class="perfume">
      <div class="photo"><Thumb src={d.image} name={d.name} eager size={720} /></div>
      <div class="info">
        <p class="by"><a href={houseUrl(d.house)}>{house.data.name}</a></p>
        <h1 class="x">{d.name}</h1>
        {d.inspiredBy && <p class="insp">Inspired by <a href={searchUrl(d.inspiredBy)}>{d.inspiredBy}</a></p>}
        <p class="src muted">Notes and details from <a href={d.source} rel="noopener" target="_blank">{host} (product page)<span class="sr">, opens in a new tab</span></a>, checked {DATA_CHECKED}.</p>
        {d.discontinued && <p><span class="tag warn">Discontinued by the brand</span></p>}

        <h2 class="label">Notes</h2>
        {layers.length ? (
          <dl class="pyramid">
            {layers.map((l) => (
              <div>
                <dt>{l.label === 'Notes' ? 'All notes' : l.label}</dt>
                <dd><ul class="chips">{l.notes.map((n) => <li><a class="chip" href={searchUrl(n)}>{n}</a></li>)}</ul></dd>
              </div>
            ))}
          </dl>
        ) : <p class="muted">{house.data.name} does not list notes for this perfume.</p>}
        {layers.length === 1 && layers[0].label === 'Notes' && <p class="hint muted">The brand lists the notes without splitting them into top, heart and base.</p>}

        <h2 class="label">Details</h2>
        <dl class="facts">
          <dt>For</dt><dd>{d.gender ? GENDER_LABEL[d.gender] : <span class="muted">Not stated</span>}</dd>
          <dt>Type</dt><dd>{d.concentration ?? <span class="muted">Not stated</span>}</dd>
          <dt>Sizes</dt><dd>{fmtSizes(d.sizesMl) ?? <span class="muted">Not stated</span>}</dd>
        </dl>

        <p class="reviews muted">Reviews are coming later.</p>
      </div>
    </article>

    {sameInspo.length > 0 && (
      <section class="section" aria-labelledby="h-same">
        <div class="section-head"><h2 id="h-same">Other local takes on {d.inspiredBy}</h2></div>
        <ul class="plist">{sameInspo.map((x) => <PerfumeRow p={x} houseName={houseName(x.data.house)} />)}</ul>
      </section>
    )}
    {similar.length > 0 && (
      <section class="section" aria-labelledby="h-sim">
        <div class="section-head"><h2 id="h-sim">Similar notes</h2><span class="muted">Local perfumes that share the less common heart and base notes of {d.name}. Very common notes such as musk are ignored.</span></div>
        <ul class="plist">{similar.map(({ x, shared }) => <PerfumeRow p={x} houseName={houseName(x.data.house)} shared={shared} />)}</ul>
      </section>
    )}
    {more.length > 0 && (
      <section class="section" aria-labelledby="h-more">
        <div class="section-head"><h2 id="h-more">More from {house.data.name}</h2><a href={houseUrl(d.house)}>See all {byHouse.get(d.house)?.length}</a></div>
        <ul class="plist">{more.map((x) => <PerfumeRow p={x} />)}</ul>
      </section>
    )}
  </div>
</Base>

<style>
  .crumbs { padding-top: 24px; }
  .perfume { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 48px; padding: 8px 0 40px; align-items: start; }
  .photo { position: sticky; top: 16px; }
  .by { margin: 0 0 6px; font-weight: 600; }
  .by a { text-decoration: none; }
  .by a:hover { text-decoration: underline; }
  h1 { font-weight: 800; font-size: clamp(34px, 4.6vw, 60px); }
  .insp { font-size: 18px; margin: 12px 0 0; }
  .insp a { font-weight: 600; }
  .label { font-size: 16px; font-weight: 750; margin: 28px 0 10px; letter-spacing: 0; }
  .pyramid { margin: 0; border-top: var(--line); }
  .pyramid > div { display: grid; grid-template-columns: 76px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .pyramid dt { font-weight: 700; padding-top: 5px; }
  .pyramid dd { margin: 0; }
  .hint { font-size: 14px; margin: 8px 0 0; }
  .reviews { margin: 16px 0 0; font-size: 14.5px; }
  .src { margin: 10px 0 0; font-size: 14.5px; }
  .src a { color: inherit; }
  @media (max-width: 860px) {
    .perfume { grid-template-columns: 1fr; gap: 20px; }
    .photo { position: static; max-width: 420px; }
  }
</style>
