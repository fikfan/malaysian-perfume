---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap">
    <header class="page-head">
      <h1 class="x">Page not found</h1>
      <p>This page does not exist. The perfume may have been renamed, or the link has a typo.</p>
    </header>
    <div class="btn-row"><a class="btn" href="/">Go to the home page</a><a class="btn" href="/search/">Search perfumes</a></div>
  </div>
</Base>
