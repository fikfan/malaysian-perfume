---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import { load, noteCounts, searchUrl, GENDER_LABEL } from '../lib/data';

const { houses } = await load();
const tips = (await noteCounts()).slice(0, 8).map(([n]) => n);
---
<Base title="Search" description="Search Malaysian perfumes by name, house, note, or the designer scent they are inspired by.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="x">Search</h1>
      <p>Search by perfume name, house, a note such as oud or vanilla, or the designer scent it is inspired by. Every word you type must match.</p>
    </header>
    <SearchBox id="search-q" />

    <div class="filters" id="filters">
      <label class="sr" for="f-house">House</label>
      <select class="select" id="f-house">
        <option value="">All houses</option>
        {houses.map((h) => <option value={h.id}>{h.data.name}</option>)}
      </select>
      <label class="sr" for="f-gender">For</label>
      <select class="select" id="f-gender">
        <option value="">Anyone</option>
        {Object.entries(GENDER_LABEL).map(([v, l]) => <option value={v}>{l}</option>)}
        <option value="none">Not stated</option>
      </select>
      <label class="check"><input type="checkbox" id="f-disc" /> Hide discontinued</label>
      <span class="count" id="count" aria-live="polite"></span>
    </div>

    <h2 class="sr">Results</h2>
    <ul class="plist" id="results"></ul>
    <div id="empty" class="empty" hidden>
      <h2>No perfume matches that.</h2>
      <p class="muted">Check the spelling, remove a filter, or try a common note:</p>
      <ul class="chips">{tips.map((t) => <li><a class="chip" href={searchUrl(t)}>{t}</a></li>)}</ul>
    </div>
    <p id="more-wrap" hidden><button type="button" class="btn" id="more">Show more</button></p>
    <noscript><p>Search needs JavaScript. You can still browse <a href="/houses/">all houses</a>.</p></noscript>
  </div>
</Base>

<script>
  import { fold, haystack, terms as termsOf, matches, OUD } from '../lib/match';
  import { GENDER_LABEL } from '../lib/labels';
  import { esc, thumbHtml } from '../lib/render';
  import type { SearchRow as Row } from '../lib/contracts';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLInputElement>('search-q'), house = $<HTMLSelectElement>('f-house'), gender = $<HTMLSelectElement>('f-gender'), disc = $<HTMLInputElement>('f-disc');
  const out = $('results'), count = $('count'), empty = $('empty'), moreWrap = $('more-wrap');
  const PAGE = 40;
  let rows: Row[] = [], hay: string[] = [], limit = PAGE;

  // Mark matches on folded text, then map back to the original characters
  function hl(s: string, terms: string[]) {
    if (!terms.length) return esc(s);
    let f = ''; const map: number[] = []; const chars = [...s];
    chars.forEach((ch, i) => { for (const c of fold(ch)) { f += c; map.push(i); } });
    const on = new Array(chars.length).fill(false);
    for (const t of terms) { let k = f.indexOf(t); while (k >= 0) { if (k === 0 || !/[a-z0-9]/.test(f[k - 1])) for (let j = k; j < k + t.length; j++) on[map[j]] = true; k = f.indexOf(t, k + 1); } }
    let o = '', open = false;
    chars.forEach((ch, i) => { if (on[i] !== open) { o += on[i] ? '<mark>' : '</mark>'; open = on[i]; } o += esc(ch); });
    return o + (open ? '</mark>' : '');
  }
  const thumb = (r: Row) => `<div class="thumb-wrap">${thumbHtml(r.img, r.n, 176)}</div>`; // 176 = ROW_IMG
  const row = (r: Row, t: string[]) => `<li class="prow">${thumb(r)}<div>
      <h3><a href="${esc(r.u)}">${hl(r.n, t)}</a></h3>
      <p class="meta">by <b>${hl(r.hn, t)}</b></p>
      ${r.i ? `<p class="meta">Inspired by <b>${hl(r.i, t)}</b></p>` : ''}
      <div class="tags">${r.g ? `<span class="tag">${GENDER_LABEL[r.g]}</span>` : ''}${r.d ? '<span class="tag warn">Discontinued</span>' : ''}</div></div>
      ${r.l.length ? `<div class="notes-line notes-grid">${r.l.map(([lab, ns]) => `<span class="layer" data-l="${esc(lab)}">${esc(lab)}</span><span>${hl(ns.join(', '), t)}</span>`).join('')}</div>` : '<p class="notes-line empty">The brand does not list notes for this one.</p>'}</li>`;

  function run(push = true) {
    const q = input.value.trim();
    const terms = termsOf(q);
    const hits = rows.map((r, i) => ({ r, i })).filter(({ r, i }) => (!house.value || r.h === house.value) && (!gender.value || r.g === gender.value || (gender.value === 'none' && !r.g)) && (!disc.checked || !r.d) && matches(hay[i], terms));
    // Rank once per search: whole-word matches first, then name matches, then inspiration, then notes
    const score = ({ r, i }: { r: Row; i: number }) => {
      if (!terms.length) return 0;
      const whole = terms.every((t) => (hay[i] + ' ').includes(' ' + t + ' ')) ? 0 : 3;
      const has = (s: string | null) => !!s && terms.some((t) => haystack(s).includes(' ' + t));
      return whole + (has(r.n) ? 0 : has(r.i) ? 1 : 2);
    };
    const list = hits.map((h) => ({ ...h, s: score(h) }))
      .sort((a, b) => a.r.d - b.r.d || a.s - b.s || (terms.length ? a.r.n.localeCompare(b.r.n) : 0))
      .map((h) => h.r);
    const marks = terms.some((t) => OUD.includes(t)) ? [...new Set([...terms, ...OUD])] : terms;
    out.innerHTML = list.slice(0, limit).map((r) => row(r, marks)).join('');
    count.textContent = `${list.length} perfume${list.length === 1 ? '' : 's'}`;
    empty.hidden = list.length > 0;
    moreWrap.hidden = list.length <= limit;
    if (push) {
      const u = new URL(location.href);
      for (const [k, v] of [['q', q], ['house', house.value], ['for', gender.value], ['hidedisc', disc.checked ? '1' : '']] as const) v ? u.searchParams.set(k, v) : u.searchParams.delete(k);
      history.replaceState(null, '', u);
    }
  }

  const p = new URLSearchParams(location.search);
  input.value = p.get('q') ?? '';
  house.value = p.get('house') ?? '';
  gender.value = p.get('for') ?? '';
  disc.checked = p.get('hidedisc') === '1';
  input.form!.addEventListener('submit', (e) => { e.preventDefault(); limit = PAGE; run(); });
  let t: number;
  input.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { limit = PAGE; run(); }, 120); });
  [house, gender, disc].forEach((el) => el.addEventListener('change', () => { limit = PAGE; run(); }));
  $('more').addEventListener('click', () => { limit += PAGE; run(false); out.children[limit - PAGE]?.querySelector('a')?.focus(); });

  count.textContent = 'Loading…';
  fetch('/search-index.json').then((r) => r.json()).then((data: Row[]) => {
    rows = data;
    hay = rows.map((r) => haystack([r.n, r.hn, r.i ?? '', r.f, ...r.l.flatMap(([, ns]) => ns)].join(' ')));
    run(false);
    if (!input.value) input.focus();
  }).catch(() => { count.textContent = 'Search could not load. Refresh the page to try again.'; });
</script>

<style>
  .wrap > :global(.searchbox) { max-width: 640px; margin-bottom: 18px; }
</style>
