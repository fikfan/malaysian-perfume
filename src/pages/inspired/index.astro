---
import Base from '../../layouts/Base.astro';
import { load, inspirations, perfumeUrl, scentSlug, inspiredUrl, SCENT_PAGE_MIN } from '../../lib/data';
import { INSPIRATION_POLICY } from '../../lib/labels';
import { breadcrumbLd, collectionPageLd } from '../../lib/seo';

const { houses } = await load();
const hn = new Map(houses.map((h) => [h.id, h.data.name]));
const list = await inspirations();
const description = "Local Malaysian perfumes whose brands name a designer or niche scent as the inspiration, listed A to Z with a link to each brand's source.";
const letter = (s: string) => (/[a-z]/i.test(s[0]) ? s[0].toUpperCase() : '#');
const letters = [...new Set(list.map(([n]) => letter(n)))];
---
<Base
  title="Local Malaysian perfumes inspired by designer scents"
  description={description}
  jsonLd={[collectionPageLd('Local Malaysian perfumes inspired by designer scents', '/inspired/', description), breadcrumbLd([['Inspirations', '/inspired/']])]}
>
  <div class="wrap"><div class="inspired">
    <header class="page-head">
      <h1 class="x">Inspired by</h1>
      <p>{list.length} designer and niche scents, and the local perfumes made after them. {INSPIRATION_POLICY}</p>
    </header>
    <div class="tools">
      <label class="sr" for="filter">Filter inspirations</label>
      <input class="filter" id="filter" type="search" placeholder="Filter, e.g. Dior or Aventus" autocomplete="off" />
      <span class="count" id="count" aria-live="polite">{list.length} scents</span>
    </div>
    <nav class="az" aria-label="Jump to letter">{letters.map((l) => <a href={`#l-${l}`}>{l}</a>)}</nav>
    {letters.map((l) => (
      <section class="letter" id={`l-${l}`} aria-labelledby={`h-${l}`}>
        <h2 id={`h-${l}`} class="x">{l}</h2>
        <dl>
          {list.filter(([n]) => letter(n) === l).map(([name, ps]) => (
            <div class="row" id={scentSlug(name)} data-k={`${name} ${ps.map((p) => p.data.name + ' ' + hn.get(p.data.house)).join(' ')}`.toLowerCase()}>
              <dt>{ps.length >= SCENT_PAGE_MIN ? <a href={inspiredUrl(name, ps.length)}>{name}</a> : name} <span class="muted n">{ps.length} local {ps.length === 1 ? 'take' : 'takes'}</span></dt>
              <dd>{ps.map((p, i) => <>{i > 0 && ', '}<a href={perfumeUrl(p)}>{p.data.name}</a> <span class="muted">({hn.get(p.data.house)})</span></>)}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div></div>
</Base>

<script>
  import { haystack, terms, matches } from '../../lib/match';
  const input = document.getElementById('filter') as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLElement>('.row')];
  const keys = rows.map((r) => haystack(r.dataset.k ?? ''));
  input.addEventListener('input', () => {
    const ts = terms(input.value);
    let n = 0;
    rows.forEach((r, i) => { const show = matches(keys[i], ts); r.hidden = !show; if (show) n++; });
    document.querySelectorAll<HTMLElement>('.letter').forEach((s) => {
      s.hidden = !s.querySelector('.row:not([hidden])');
      const a = document.querySelector<HTMLAnchorElement>(`.az a[href="#${s.id}"]`);
      a?.toggleAttribute('aria-disabled', s.hidden);
      // a letter with no matches leaves the tab order too
      if (s.hidden) a?.setAttribute('tabindex', '-1'); else a?.removeAttribute('tabindex');
    });
    document.getElementById('count')!.textContent = `${n} scent${n === 1 ? '' : 's'}`;
  });
</script>

<style>
  .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 12px; }
  .az { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; position: sticky; top: 0; background: var(--paper); padding: 8px 0; z-index: 5; border-bottom: 1px solid var(--rule); }
  .n { font-weight: 400; font-size: 14px; white-space: nowrap; }
  .az a { min-width: 36px; min-height: 36px; display: grid; place-items: center; text-decoration: none; font-weight: 700; border: 1px solid var(--rule); border-radius: var(--radius); }
  .az a:hover { border-color: var(--ink); }
  .az a[aria-disabled] { opacity: .3; pointer-events: none; }
  .inspired { max-width: 980px; }
  .letter { padding-top: 24px; scroll-margin-top: 56px; }
  .row { scroll-margin-top: 64px; }
  @media (max-width: 640px) { .az { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); padding-right: 32px; } .az a { flex: none; } }
  .letter h2 { font-size: 32px; font-weight: 800; border-bottom: var(--line); padding-bottom: 6px; }
  dl { margin: 0; }
  .row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 4px 24px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  dt { font-weight: 700; }
  dd { margin: 0; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } }
</style>
