---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import Thumb from '../components/Thumb.astro';
import { load, noteCounts, houseUrl, searchUrl, perfumeUrl, imgUrl, countLabel, currentWithPhoto, TILE_IMG, TYPE_LABEL } from '../lib/data';
import type { HeroHouse } from '../lib/contracts';
import { websiteLd } from '../lib/seo';

const { houses, perfumes, byHouse } = await load();
const notes = await noteCounts();

// Designer scents that more than one local perfume is inspired by
const insp = new Map<string, number>();
for (const p of perfumes) if (p.data.inspiredBy) insp.set(p.data.inspiredBy, (insp.get(p.data.inspiredBy) ?? 0) + 1);
const inspired = [...insp].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 12);
const listOf = (id: string) => byHouse.get(id) ?? [];
const coverOf = (id: string) => currentWithPhoto(listOf(id))[0]?.data.image ?? listOf(id)[0]?.data.image;
// No-JS hero: one current perfume from every other house, never the one already used as that house's cover below
const picks = houses.filter((_, i) => i % 2 === 0).slice(0, 6).flatMap((h) => {
  const ok = currentWithPhoto(listOf(h.id));
  const p = ok.find((x) => x.data.image !== coverOf(h.id)) ?? ok[0];
  return p ? [{ h, p }] : [];
});
// Pool for the shuffle: every house, with its cover and up to 12 current perfumes that have a photo
const pool: HeroHouse[] = houses.map((h) => ({
  n: h.data.name, u: houseUrl(h.id), c: countLabel(h, listOf(h.id).length), img: imgUrl(coverOf(h.id), TILE_IMG * 2),
  p: currentWithPhoto(listOf(h.id)).slice(0, 12).map((p) => ({ n: p.data.name, u: perfumeUrl(p), img: imgUrl(p.data.image, TILE_IMG * 2) })),
}));
---
<Base title="Malaysian Perfumes: local perfume houses, notes and inspirations" description={`Find perfumes made in Malaysia: ${houses.length} local perfume houses and ${perfumes.length} fragrances, with notes, what each one is inspired by, and where the brand sells it.`} jsonLd={websiteLd()} showSearch={false}>
  <section class="hero wrap">
    <div class="hero-text">
    <h1 class="x">Malaysian perfumes,<br /> in one place.</h1>
    <SearchBox big id="hero-q" />
    <dl class="stats">
      <div><dt>Houses</dt><dd>{houses.length}</dd></div>
      <div><dt>Perfumes</dt><dd>{perfumes.length}</dd></div>
      <div><dt>Notes</dt><dd>{notes.length}</dd></div>
    </dl>
    </div>
    <div class="hero-side">
    <ul class="hero-grid" id="hero-grid" aria-label="A few perfumes and houses in the library">
      {picks.map(({ h, p }) => (
        <li>
          <Thumb src={p.data.image} name={p.data.name} size={TILE_IMG} />
          <a href={perfumeUrl(p)}>{p.data.name}</a>
          <span class="muted">{h.data.name}</span>
        </li>
      ))}
    </ul>
    <button type="button" class="shuffle" id="shuffle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>Shuffle</button>
    </div>
    <script type="application/json" id="hero-pool" set:html={JSON.stringify(pool).replace(/</g, '\\u003c')} />
    <p class="sr" id="shuffle-status" aria-live="polite"></p>
    <script>
      import type { HeroHouse } from '../lib/contracts';
      import { esc, thumbHtml, shuffle, withFade } from '../lib/render';
      // Random mix on every visit: 4 perfumes and 2 houses, all from different houses, in random order
      const pool: HeroHouse[] = JSON.parse(document.getElementById('hero-pool')!.textContent!);
      const grid = document.getElementById('hero-grid')!;
      const SIZE = 240; // TILE_IMG
      const pick = <T,>(a: T[]) => a[Math.floor(Math.random() * a.length)];
      const tile = (img: string | null, name: string, href: string, sub: string, kind: string) =>
        `<li class="${kind}">${thumbHtml(img, name, SIZE)}<a href="${esc(href)}">${esc(name)}</a><span class="muted">${esc(sub)}</span></li>`;
      const draw = () => {
        const tiles = shuffle(pool.filter((h) => h.p.length)).slice(0, 6).map((h, i) => {
          if (i < 2) return tile(h.img, h.n, h.u, `${h.c} perfumes`, 'is-house');
          const p = pick(h.p);
          return tile(p.img, p.n, p.u, h.n, 'is-perfume');
        });
        grid.innerHTML = shuffle(tiles).join('');
        grid.classList.add('ready');
      };
      draw();
      document.getElementById('shuffle')!.addEventListener('click', () => {
        withFade(draw);
        document.getElementById('shuffle-status')!.textContent = 'Shuffled';
      });
    </script>
  </section>

  <div class="wrap">
  <section class="section" aria-labelledby="h-houses">
    <div class="section-head"><h2 id="h-houses">Houses</h2><a href="/houses/">All houses and who is coming next</a></div>
    <ul class="houses">
      {houses.map((h) => (
        <li class="house">
          <Thumb src={coverOf(h.id)} name={h.data.name} size={TILE_IMG} />
          <div>
            <h3><a href={houseUrl(h.id)}>{h.data.name}</a></h3>
            <p class="muted">{TYPE_LABEL[h.data.type]}</p>
            <p class="n">{countLabel(h, listOf(h.id).length)} perfumes</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="h-notes">
    <div class="section-head"><h2 id="h-notes">Find by note</h2><span class="muted">The number shows how many perfumes have that note.</span></div>
    <ul class="chips">
      {notes.slice(0, 36).map(([n, c]) => <li><a class="chip" href={searchUrl(n)}>{n} <small>{c}</small></a></li>)}
    </ul>
  </section>

  {inspired.length > 0 && (
    <section class="section" aria-labelledby="h-insp">
      <div class="section-head"><h2 id="h-insp">Local takes on designer scents</h2><span class="muted">Only where the brand itself names the inspiration.</span></div>
      <ul class="chips">
        {inspired.map(([n, c]) => <li><a class="chip" href={searchUrl(n)}>{n} <small>{c}</small></a></li>)}
      </ul>
    </section>
  )}
  </div>
</Base>

<style>
  .hero { padding: 56px var(--gutter) 40px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: 56px; align-items: center; }
  :global(.js) .hero-grid:not(.ready) { visibility: hidden; }
  .hero-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 12px; }
  .hero-grid :global(li) { position: relative; display: grid; gap: 2px; font-size: 13.5px; line-height: 1.3; }
  .hero-grid :global(.thumb) { margin-bottom: 6px; }
  .hero-grid :global(a) { font-weight: 700; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hero-grid :global(a)::after { content: ""; position: absolute; inset: 0; }
  .hero-grid :global(li:hover a) { text-decoration: underline; }
  .hero-grid :global(li:hover .thumb) { outline-color: var(--ink); }
  .hero-grid :global(span) { font-size: 12.5px; }
  .hero-grid :global(.is-house .thumb) { outline: 1.5px solid var(--ink); outline-offset: -1.5px; }
  .hero-side { display: grid; gap: 14px; }
  .shuffle { justify-self: start; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper); font-weight: 600; cursor: pointer; }
  .shuffle:hover { border-color: var(--ink); }
  .shuffle svg { width: 16px; height: 16px; }
  .hero h1 { font-weight: 800; font-size: clamp(38px, 5.4vw, 74px); line-height: .95; letter-spacing: -.03em; max-width: 11ch; }
  .hero :global(.searchbox) { max-width: 640px; margin-top: 32px; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 160px)); margin: 32px 0 0; border-top: var(--line); }
  .stats div { padding: 12px 16px 0 0; }
  .stats dt { font-size: 14px; color: var(--muted); }
  .stats dd { margin: 2px 0 0; font-weight: 800; font-size: 34px; font-variant-numeric: tabular-nums; font-stretch: 125%; font-variation-settings: "wdth" 125; }
  .houses { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px 18px; }
  .house { position: relative; }
  .house h3 { font-size: 18px; font-weight: 750; margin-top: 10px; }
  .house h3 a { text-decoration: none; }
  .house h3 a::after { content: ""; position: absolute; inset: 0; }
  .house:hover h3 a { text-decoration: underline; text-decoration-thickness: 2px; }
  .house:hover :global(.thumb) { outline-color: var(--ink); }
  .house p { margin: 2px 0 0; font-size: 14.5px; }
  .house .n { font-weight: 600; font-variant-numeric: tabular-nums; }
  @media (max-width: 1120px) { .hero { grid-template-columns: 1fr; gap: 32px; } .hero-grid { max-width: 640px; } }
  @media (max-width: 1000px) {
    .houses { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 32px; padding-bottom: 28px; }
    .houses { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px; }
    .stats dd { font-size: 28px; }
  }
</style>
