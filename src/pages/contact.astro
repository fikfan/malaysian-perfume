---
import Base from '../layouts/Base.astro';
import { TURNSTILE_SITE_KEY } from '../lib/site';
---
<Base title="Get your brand featured" description="Feature your Malaysian perfume brand in the library for free, or ask for a correction. Send a message and I will reply by email." showSearch={false}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="x">Get featured</h1>
      <p>Listing a brand is free. Tell me about your brand, or about a correction, and I will reply by email.</p>
    </header>

    <!-- worker/index.ts handles the POST; the script below sends it without leaving the page -->
    <form class="contact" id="contact" method="post" action="/api/contact">
      <label>Brand name<input class="filter" name="brand" required maxlength="100" autocomplete="organization" /></label>
      <label><span>Your name <span class="muted">(optional)</span></span><input class="filter" name="name" maxlength="100" autocomplete="name" /></label>
      <label>Your email<input class="filter" name="email" type="email" required maxlength="200" autocomplete="email" /></label>
      <label><span>Website or shop link <span class="muted">(optional)</span></span><input class="filter" name="link" type="url" maxlength="300" placeholder="https://" /></label>
      <label>Message<textarea class="filter" name="message" required maxlength="3000" rows="6" placeholder="New brand: tell me about it. Correction: paste the page link and what to fix."></textarea></label>
      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto"></div>
      <button class="btn send" type="submit">Send message</button>
      <p class="status" id="status" role="status" aria-live="polite"></p>
    </form>
    <p class="muted small">What you send (brand, name, email, link and message) is emailed to me so I can reply. It is not shown on the site, sold or used for marketing. The form runs on Cloudflare, which also checks for spam. To have your message deleted, ask in your reply. <a href="/privacy/">Privacy notice</a>.</p>
  </div>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('contact') as HTMLFormElement;
  const status = document.getElementById('status')!;
  const send = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    send.disabled = true;
    status.className = 'status';
    status.textContent = 'Sending…';
    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const body = (await r.json().catch(() => ({}))) as { error?: string };
      if (!r.ok) throw new Error(body.error ?? 'The message could not be sent. Try again later.');
      const email = String(new FormData(form).get('email'));
      form.reset();
      status.className = 'status ok';
      status.textContent = `Thank you. Your message is sent, and I will reply to ${email}.`;
    } catch (err) {
      status.className = 'status bad';
      status.textContent = err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'The message could not be sent. Check your connection and try again.';
    } finally {
      send.disabled = false;
      // a Turnstile token works once, so get a new one for the next try
      (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
    }
  });
</script>

<style>
  .contact { display: grid; gap: 16px; max-width: 560px; }
  .contact label { display: grid; gap: 6px; font-weight: 600; font-size: 15px; }
  .contact label .muted { font-weight: 400; }
  .contact .filter { min-width: 0; width: 100%; font-weight: 400; }
  .contact textarea.filter { height: auto; padding: 10px 12px; resize: vertical; font: inherit; }
  .send { justify-self: start; background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .send:hover { background: var(--ink-hover); }
  .send:disabled { opacity: .6; cursor: wait; }
  .status { margin: 0; min-height: 1.5em; }
  .status.ok { color: var(--ink); font-weight: 600; }
  .status.bad { color: var(--warn-text); font-weight: 600; }
  .small { font-size: 14px; margin-top: 16px; max-width: 560px; }
</style>
